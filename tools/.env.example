# Cara a cara contra productos de memoria (F8-T9, Fase 2/3). Copia este fichero a tools/.env y rellena tu clave.
# tools/.env está gitignored: la clave NUNCA se versiona. Los datasets son públicos; no se envía nada tuyo.

# Proveedor del LLM: openai | gemini | claude | local
EVAL_LLM_PROVIDER=openai

# Modelos. Por defecto: respuesta barata (4o-mini) y juez oficial del leaderboard (4o).
EVAL_LLM_RESPUESTA=gpt-4o-mini
EVAL_LLM_JUEZ=gpt-4o

# Claves (según el proveedor). Pon solo la que uses.
OPENAI_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# Para local (Ollama): URL del servidor; no hace falta clave.
# EVAL_LLM_LOCAL_URL=http://localhost:11434/v1
