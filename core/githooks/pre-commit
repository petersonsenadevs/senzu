#!/usr/bin/env sh
# Senzu: antes de commitear, exige rama no principal (main, staging, production, release/*... la lista de lib.mjs) y devlog del dia.
# Instalado por sync.ps1 -GitHooks. Desactivar puntualmente: SENZU_SKIP_DEVLOG=1 (o el antiguo DEV_STANDARDS_SKIP_DEVLOG=1)
branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)
case "$branch" in
  main|master|trunk|develop|development|dev|staging|stage|stg|preprod|pre-production|production|prod|live|qa|uat|release|release/*|releases/*|production/*|prod/*|staging/*|stage/*)
    echo "[senzu] No se commitea en '$branch'. Crea una rama (git switch -c feat/...)." >&2
    exit 1 ;;
esac
# Convenciones SELLADAS por /adoptar: ningún commit las cambia ni las borra, venga de donde venga el cambio
# (agente, script, otra herramienta). Solo el usuario, si lo decide: SENZU_ALLOW_CONVENCIONES=1 git commit ...
if [ "${SENZU_ALLOW_CONVENCIONES:-$DEV_STANDARDS_ALLOW_CONVENCIONES}" != "1" ]; then
  for f in senzu/conventions.md senzu/conventions.json conventions.md conventions.json; do
    if git cat-file -e "HEAD:$f" 2>/dev/null && git show "HEAD:$f" 2>/dev/null | grep -qE '(senzu|dev-standards):inmutable' \
       && ! git diff --cached --quiet -- "$f"; then
      echo "[senzu] $f está SELLADO (/adoptar) y este commit lo cambia o lo borra. No se commitea." >&2
      echo "  Si eres el usuario y quieres cambiar las convenciones: SENZU_ALLOW_CONVENCIONES=1 git commit ..." >&2
      exit 1
    fi
  done
fi
if [ "${SENZU_SKIP_DEVLOG:-$DEV_STANDARDS_SKIP_DEVLOG}" != "1" ]; then
  today=$(date +%Y-%m-%d)
  # senzu/devlog (proyectos actuales) o devlog/ (proyectos sin migrar)
  dl=""
  if [ -d senzu/devlog ]; then dl="senzu/devlog"; elif [ -d devlog ]; then dl="devlog"; fi
  if [ -n "$dl" ] && ! ls "$dl/$today"/*.md >/dev/null 2>&1; then
    echo "[senzu] No hay entrada de devlog para hoy ($dl/$today/NNN-slug.md). Creala antes de commitear (skill devlog)." >&2
    echo "  Cambio trivial sin devlog: SENZU_SKIP_DEVLOG=1 git commit ..." >&2
    exit 1
  fi
fi
exit 0
