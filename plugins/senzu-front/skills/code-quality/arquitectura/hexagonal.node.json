{
  "_que_es": "Arquitectura declarada del proyecto: capas, carpetas y quién puede usar a quién. La hacen cumplir arquitectura-guard (al escribir) y code-quality/scripts/arquitectura.mjs --comprobar (el proyecto entero). Ajusta las rutas a las reales del proyecto antes de sellarla. Una ruta o un archivo que no encaje y sea correcto va a \"excepciones\".",
  "estilo": "hexagonal",
  "stack": "node",
  "descripcion": "Hexagonal (puertos y adaptadores): dominio en el centro sin framework, casos de uso en aplicación, adaptadores en infraestructura y entrada. Cuando hay integraciones externas o reglas de negocio que deben probarse sin la base de datos.",
  "capas": [
    {
      "nombre": "dominio",
      "rutas": [
        "src/domain/**",
        "src/*/domain/**",
        "src/modules/*/domain/**"
      ],
      "puede_usar": [],
      "prohibido": [
        "@prisma/client",
        ".prisma",
        "express",
        "fastify",
        "@nestjs",
        "typeorm",
        "mongoose",
        "knex",
        "pg",
        "mysql2",
        "axios",
        "redis",
        "ioredis",
        "@aws-sdk",
        "next",
        "drizzle-orm"
      ],
      "por_que": "el dominio no conoce el framework, la base de datos ni HTTP: así se prueba sin ellos y sobrevive a un cambio de infraestructura"
    },
    {
      "nombre": "aplicacion",
      "rutas": [
        "src/application/**",
        "src/*/application/**",
        "src/modules/*/application/**"
      ],
      "puede_usar": [
        "dominio"
      ],
      "prohibido": [
        "express",
        "fastify",
        "@prisma/client",
        "typeorm",
        "mongoose",
        "knex",
        "pg",
        "mysql2",
        "drizzle-orm"
      ],
      "por_que": "los casos de uso hablan con puertos (interfaces del dominio o de la aplicación), no con la base de datos ni con HTTP"
    },
    {
      "nombre": "infraestructura",
      "rutas": [
        "src/infrastructure/**",
        "src/*/infrastructure/**",
        "src/modules/*/infrastructure/**"
      ],
      "puede_usar": [
        "dominio",
        "aplicacion"
      ]
    },
    {
      "nombre": "entrada",
      "rutas": [
        "src/interfaces/**",
        "src/http/**",
        "src/api/**",
        "src/routes/**",
        "app/api/**",
        "src/*/interfaces/**",
        "src/*/http/**",
        "src/modules/*/interfaces/**",
        "src/modules/*/http/**",
        "src/contexts/*/interfaces/**",
        "src/contexts/*/http/**"
      ],
      "puede_usar": [
        "aplicacion"
      ],
      "por_que": "los adaptadores de entrada (HTTP, consola, colas) llaman a casos de uso; no tocan el dominio ni la base de datos por dentro"
    },
    {
      "nombre": "arranque",
      "rutas": [
        "src/main.ts",
        "src/index.ts",
        "src/app.ts",
        "src/server.ts",
        "src/container.ts",
        "src/**/*.module.ts"
      ],
      "puede_usar": [
        "dominio",
        "aplicacion",
        "infraestructura",
        "entrada"
      ],
      "por_que": "la raíz de composición conecta puertos con adaptadores"
    }
  ],
  "controladores": {
    "rutas": [
      "src/**/*.controller.ts",
      "src/controllers/**",
      "src/routes/**",
      "src/**/*.routes.ts",
      "app/api/**/route.ts"
    ],
    "orm": "(\\b(prisma|db|knex|this\\.prisma|this\\.db)\\s*(\\.\\w+)?\\s*\\.(create|createMany|findMany|findUnique|findFirst|update|updateMany|delete|deleteMany|upsert|insert|select|query|\\$queryRaw)\\s*\\(|\\.getRepository\\(|\\b[A-Z]\\w*\\.(find|findOne|findById|findByIdAndUpdate|updateOne|deleteOne|aggregate)\\s*\\()",
    "logica_en": "un caso de uso de la capa de aplicación",
    "dto": "(\\bthis\\.\\w+\\.\\w+|\\b\\w+(Service|UseCase|Servicio|CasoDeUso)\\.\\w+)\\(\\s*(req|request)\\.body\\s*[,)]",
    "dto_en": "un tipo inferido del schema de validación (zod) o una clase DTO"
  },
  "excepciones": [
    "prisma/**",
    "migrations/**",
    "scripts/**",
    "test/**",
    "tests/**",
    "drizzle/**"
  ]
}
