#!/usr/bin/env sh
# Senzu: capa dura del push, comun a Claude Code, Codex, Cursor y Windsurf. Instalado por sync.ps1 -GitHooks.
# La misma regla que el hook guard (D-042):
#   - a las ramas de TRABAJO (feat/..., fix/...) se sube sin configurar nada;
#   - a una rama PRINCIPAL (main, master, develop, staging, production, release/*... la misma lista que lib.mjs)
#     solo con "pushMain": true en senzu/senzu.json o SENZU_ALLOW_PUSH_MAIN=1: un push a staging o production despliega;
#   - "push": false en senzu/senzu.json lo bloquea todo (salvo SENZU_ALLOW_PUSH=1, si el usuario lo aprueba).
# El forzado lo bloquea el hook guard (aqui no se ve el --force).
raiz=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
marcador=""
for f in "$raiz/senzu/senzu.json" "$raiz/.dev-standards.json"; do
  if [ -f "$f" ]; then marcador="$f"; break; fi
done
if [ -n "$marcador" ] && grep -Eq '"push"[[:space:]]*:[[:space:]]*false' "$marcador" \
   && [ "${SENZU_ALLOW_PUSH:-$DEV_STANDARDS_ALLOW_PUSH}" != "1" ]; then
  echo "[senzu] git push bloqueado: este proyecto tiene \"push\": false en $(basename "$marcador")." >&2
  echo "  Si el humano lo aprueba, ejecuta:  SENZU_ALLOW_PUSH=1 git push ...  (o set SENZU_ALLOW_PUSH=1 en Windows)" >&2
  exit 1
fi
if [ "$SENZU_ALLOW_PUSH_MAIN" = "1" ]; then
  exit 0
fi
if [ -n "$marcador" ] && grep -Eq '"pushMain"[[:space:]]*:[[:space:]]*true' "$marcador"; then
  exit 0
fi
# git pasa por stdin una linea por ref: <ref local> <sha local> <ref remota> <sha remota>
while read -r local_ref local_sha remote_ref remote_sha; do
  rama=$(printf '%s' "$remote_ref" | sed 's#^refs/heads/##' | tr 'A-Z' 'a-z')
  case "$rama" in
    main|master|trunk|develop|development|dev|staging|stage|stg|preprod|pre-production|production|prod|live|qa|uat|release|release/*|releases/*|production/*|prod/*|staging/*|stage/*)
      echo "[senzu] push a la rama principal '$rama' bloqueado." >&2
      echo "  Si el humano lo aprueba: SENZU_ALLOW_PUSH_MAIN=1 git push ...  (o \"pushMain\": true en senzu/senzu.json)" >&2
      exit 1 ;;
  esac
done
exit 0
